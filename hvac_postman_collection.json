{
  "info": {
    "name": "HVAC API Collection",
    "_postman_id": "c8c9a1e3-2c8b-4a5e-bd2a-123456789abc",
    "description": "Postman collection for HVAC, HVAC Realtime Data, and HVAC Logs APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3029"
    },
    {
      "key": "hvac_id",
      "value": "HVAC001"
    }
  ],
  "item": [
    {
      "name": "HVAC",
      "item": [
        {
          "name": "Create HVAC",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hvac",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hvac"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hvac_name\": \"Main Hall AC\",\n  \"hvac_brand\": \"Daikin\",\n  \"hvac_model\": \"DX-123\",\n  \"hvac_installation_location\": \"Main Hall\"\n}"
            }
          }
        },
        {
          "name": "Get All HVACs (Pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hvac?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hvac"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get HVAC By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hvac/{{hvac_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hvac", "{{hvac_id}}"]
            }
          }
        },
        {
          "name": "Update HVAC",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hvac/{{hvac_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hvac", "{{hvac_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hvac_fan_speed\": \"High\",\n  \"hvac_notes\": \"Updated via API\"\n}"
            }
          }
        },
        {
          "name": "Delete HVAC",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/hvac/{{hvac_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hvac", "{{hvac_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "HVAC Realtime Data",
      "item": [
        {
          "name": "Get HVAC Realtime Data",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hvacData/{{hvac_id}}/mitsubishi-electric-hvac-data",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hvacData", "{{hvac_id}}", "mitsubishi-electric-hvac-data"]
            }
          }
        }
      ]
    },
    {
      "name": "HVAC Logs",
      "item": [
        {
          "name": "Get All HVAC Logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hvacLogs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hvacLogs"]
            }
          }
        }
      ]
    }
  ]
}
